{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "folioblocks/pb-image-block",
	"version": "1.5",
	"title": "Image Block",
	"category": "folioblocks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1247.24 1247.24\"><path d=\"M180 180h887c48 0 88 40 88 88v711c0 48-40 88-88 88H180c-48 0-88-40-88-88V268c0-48 40-88 88-88m0 50c-30 0-56 26-56 56v675c0 30 26 56 56 56h887c30 0 56-26 56-56V286c0-30-26-56-56-56z\"/><path d=\"M455 335a85 85 0 1 0 0 170 85 85 0 1 0 0-170\"/><path d=\"M820 520c17 0 33 9 41 24l205 355c8 14 8 31 0 45s-24 24-41 24H300c-17 0-32-9-41-24s-8-33 3-47l125-170c8-11 21-18 35-18s27 6 35 18l45 65 95-160c8-14 24-24 41-24Z\"/></svg>",
	"description": "Custom image block used by the FolioBlocks gallery blocks.",
	"keywords": [ "img", "photo", "picture" ],
	"example": {
    	"attributes": {
        	"preview": true
    	}
    },
	"supports": {
		"inserter": true,
		"customClassName": false,
		"html": false,
		"anchor": false,
		"align": [ "wide", "full" ],
		"color": { "text": false,
		"background": false},
		"filter": { "duotone": false }
	},
	"attributes": {
		"preview": { "type": "boolean", "default": false },
		"id": { "type": "number", "default": 0 },
		"src": { "type": "string", "default": "" },
		"imageSize": { "type": "string", "default": "large" },
		"sizes": { "type": "object", "default": {} },
		"width": { "type": "number", "default": 0 },
		"height": { "type": "number", "default": 0 },
		"borderColor": { "type": "string", "default": "#ffffff"},
		"borderWidth": { "type": "number", "default": 0 },
		"borderRadius": { "type": "number", "default": 0 },
		"alt": { "type": "string", "default": ""},
		"caption": { "type": "string", "default": ""},
		"title": { "type": "string", "default": "" },
		"exifCamera": { "type": "string", "default": "" },
		"exifFocalLength": { "type": "string", "default": "" },
		"exifShutterSpeed": { "type": "string", "default": "" },
		"exifAperture": { "type": "string", "default": "" },
		"exifIso": { "type": "string", "default": "" },
		"class": { "type": "string", "default": "" },
		"enableLightbox": { "type": "boolean", "default": false },
		"showCaptionInLightbox": { "type": "boolean", "default": false },
		"showTitleOnHover": { "type": "boolean", "default": false },
			"onHoverStyle": { "type": "string", "enum": ["fade-overlay","gradient-bottom","chip",
				"chip-gradient","blur-overlay","color-overlay","gradient-overlay"], "default": "blur-overlay"},
			"hoverEffect": { "type": "string", "enum": ["none","zoom-in","zoom-out","lift","tilt","pop","glare","pan","desaturate"], "default": "none" },
			"overlayEntrance": { "type": "string", "enum": ["default","fade","slide-up","slide-down","slide-left","slide-right"], "default": "default" },
			"overlayBgColor": { "type": "string", "default": "#f9f9f9" },
			"overlayBgGradient": { "type": "string", "default": "" },
			"overlayTextColor": { "type": "string", "default": "#000000" },
			"overlayFontFamily": { "type": "string", "default": "" },
			"overlayFontWeight": { "type": "string", "default": "" },
			"overlayFontStyle": { "type": "string", "enum": ["", "normal", "italic"], "default": "" },
			"chipOverlayBgColor": { "type": "string", "default": "#f9f9f9" },
			"chipOverlayBgGradient": { "type": "string", "default": "linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(226,232,240,0.82) 100%)" },
			"chipOverlayTextColor": { "type": "string", "default": "#000000" },
			"dropShadow": { "type": "boolean", "default": false },
			"shadowStyle": { "type": "string", "enum": ["", "none", "subtle", "soft", "elevated", "dramatic"], "default": "" },
		"filterCategory": { "type": "string", "default": ""}, 
		"filterCategories": { "type": "array", "items": { "type": "string" }, "default": [] },
		"enableDownload": { "type": "boolean" },
       	"downloadOnHover": { "type": "boolean", "default": true },
		"downloadIconColor": { "type": "string", "default": "#000000" },
		"downloadIconBgColor": { "type": "string", "default": "#f9f9f9" },
		"lazyLoad": { "type": "boolean", "default": false }, 
		"disableRightClick": { "type": "boolean", "default": false },
		"wooProductId": { "type": "number", "default": 0 },
		"wooProductName": { "type": "string", "default": ""},
		"wooProductPrice": { "type": "string", "default": "" },
		"wooProductImage": { "type": "string", "default": "" },
		"wooProductURL": { "type": "string", "default": "" },
		"enableWooCommerce": { "type": "boolean", "default": false },
		"wooCartIconDisplay": { "type": "string", "enum": ["none", "hover", "always"], "default": "hover" },
		"cartIconColor": { "type": "string", "default": "#000000" },
		"cartIconBgColor": { "type": "string", "default": "#f9f9f9" },
		"linkIconColor": { "type": "string", "default": "#000000" },
		"linkIconBgColor": { "type": "string", "default": "#f9f9f9" },
		"wooProductPriceOnHover": { "type": "boolean", "default": false },
			"overlayContent": { "type": "string", "enum": ["title", "caption", "product", "exif", "social"], "default": "title" },
		"wooLightboxInfoType": { "type": "string", "default": "caption" },
		"wooLinkAction": { "type": "string", "enum": ["inherit", "product", "add_to_cart"], "default": "inherit" },
		"overrideGalleryClickSettings": { "type": "boolean", "default": false },
		"overrideGalleryHoverSettings": { "type": "boolean", "default": false },
		"imageClickAction": { "type": "string", "enum": ["none", "lightbox", "download", "woocommerce", "media_file", "custom_url", "page_post"], "default": "" },
		"imageClickTarget": { "type": "string", "enum": ["icon", "thumbnail"], "default": "icon" },
		"linkIconDisplay": { "type": "string", "enum": ["none", "hover", "always"], "default": "hover" },
		"enableWatermarking": { "type": "boolean", "default": false },
		"watermarkId": { "type": "string", "default": "" },
		"watermarkDisplay": { "type": "string", "enum": ["none", "gallery", "lightbox", "both"], "default": "none" },
		"customUrl": { "type": "string", "default": "" },
		"customUrlOpenInNewTab": { "type": "boolean", "default": false },
		"linkedPostId": { "type": "number", "default": 0 },
		"linkedPostTitle": { "type": "string", "default": "" },
		"linkedPostUrl": { "type": "string", "default": "" },
		"linkedPostType": { "type": "string", "default": "" },
		"linkedPostOpenInNewTab": { "type": "boolean", "default": false },
		"lightbox": { "type": "boolean", "default": false },
		"lightboxCaption": { "type": "boolean", "default": false },
		"lightboxTheme": { "type": "string", "enum": ["inherit", "dark", "light"], "default": "inherit" },
			"lightboxContent": { "type": "string", "enum": ["none", "title", "caption", "product", "exif", "title_exif", "caption_exif", "title_caption", "title_caption_exif", "social"], "default": "" },
		"lightboxCounter": { "type": "boolean", "default": false },
		"lightboxZoom": { "type": "boolean", "default": false },
		"enableSocialSharing": { "type": "boolean", "default": false },
		"socialSharingSources": { "type": "array", "default": ["facebook", "linkedin", "x", "pinterest", "copy"], "items": { "type": "string" } },
		"enableLightboxSocialSharing": { "type": "boolean", "default": false },
		"hideUnknownExifFields": { "type": "boolean", "default": false }
	},
	"usesContext": [
		"folioBlocks/resolution",
		"folioBlocks/dropShadow",
		"folioBlocks/shadowStyle",
		"folioBlocks/lightbox",
		"folioBlocks/lightboxCaption",
		"folioBlocks/lightboxTheme",
		"folioBlocks/lightboxContent",
		"folioBlocks/lightboxCounter",
		"folioBlocks/lightboxZoom",
		"folioBlocks/enableSocialSharing",
		"folioBlocks/socialSharingSources",
		"folioBlocks/enableLightboxSocialSharing",
		"folioBlocks/hideUnknownExifFields",
		"folioBlocks/onHoverTitle",
		"folioBlocks/onHoverStyle",
		"folioBlocks/hoverEffect",
		"folioBlocks/overlayEntrance",
		"folioBlocks/enableFilter",
		"folioBlocks/filterCategories",
		"folioBlocks/activeFilter",
			"folioBlocks/overlayBgColor",
			"folioBlocks/overlayBgGradient",
			"folioBlocks/overlayTextColor",
			"folioBlocks/overlayFontFamily",
			"folioBlocks/overlayFontWeight",
			"folioBlocks/overlayFontStyle",
			"folioBlocks/chipOverlayBgColor",
			"folioBlocks/chipOverlayBgGradient",
			"folioBlocks/chipOverlayTextColor",
			"folioBlocks/borderWidth",
		"folioBlocks/borderRadius",
		"folioBlocks/borderColor", 
		"folioBlocks/enableDownload",
        "folioBlocks/downloadOnHover",
		"folioBlocks/downloadIconColor",
		"folioBlocks/downloadIconBgColor",
		"folioBlocks/hasWooCommerce",
		"folioBlocks/enableWooCommerce",
    	"folioBlocks/wooCartIconDisplay",
		"folioBlocks/cartIconColor",
		"folioBlocks/cartIconBgColor",
		"folioBlocks/linkIconColor",
		"folioBlocks/linkIconBgColor",
        "folioBlocks/wooDefaultLinkAction",
        "folioBlocks/wooLightboxInfoType",
        "folioBlocks/wooProductPriceOnHover",
        "folioBlocks/overlayContent",
        "folioBlocks/lazyLoad",
		"folioBlocks/carouselHeight",
		"folioBlocks/inCarousel",
		"folioBlocks/imageClickAction",
		"folioBlocks/imageClickTarget",
		"folioBlocks/linkIconDisplay",
		"folioBlocks/enableWatermarking",
		"folioBlocks/watermarkId",
		"folioBlocks/watermarkDisplay",
		"folioBlocks/isProofingGallery",
		"folioBlocks/proofingEnableHeart",
		"folioBlocks/proofingEnableFlag",
		"folioBlocks/proofingEnableComment"
	],
	"textdomain": "folioblocks",
	"editorScript": [
    "file:./index.js",
    "file:./premium.js"
	],
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": [
    "file:./view.js",
    "file:./premium-view.js"
	]
}
